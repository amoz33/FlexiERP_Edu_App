# ─── EduManage Next.js Frontend ───────────────────────────────────
# Copy this file to .env.local and fill in your values

# Laravel Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# PayStack
# Required by components/payment/PayStackModal.tsx - payment initialization
# fails with a "PayStack public key is not configured" error if this is unset.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# App
NEXT_PUBLIC_APP_NAME=EduManage
NEXT_PUBLIC_APP_VERSION=1.0.0
